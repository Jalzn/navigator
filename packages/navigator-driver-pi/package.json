{
  "name": "@navigator/driver-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "navigator-driver-pi": "dist/main.js"
  },
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "prebuild": "npm --prefix ../../crates/navigator-driver-protocol/typescript run build",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && npm run build && node --preserve-symlinks --import tsx --test test/*.test.ts",
    "start": "node --preserve-symlinks dist/main.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.10.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@navigator/driver-protocol": "file:../../crates/navigator-driver-protocol/typescript"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
